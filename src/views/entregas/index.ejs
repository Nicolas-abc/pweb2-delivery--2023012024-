<div class="card">
  <div class="row">
    <h1>Entregas</h1>
    <a class="btn btn-primary" href="/entregas/nova">Nova Entrega</a>
  </div>

  <form method="GET" action="/entregas" class="section">
    <div class="form-grid">
      <div class="field">
        <label for="status">Filtrar por status</label>
        <select id="status" name="status">
          <option value="">Todos</option>
          <option value="CRIADA" <%= filtroStatus === 'CRIADA' ? 'selected' : '' %>>CRIADA</option>
          <option value="EM_TRANSITO" <%= filtroStatus === 'EM_TRANSITO' ? 'selected' : '' %>>EM_TRANSITO</option>
          <option value="ENTREGUE" <%= filtroStatus === 'ENTREGUE' ? 'selected' : '' %>>ENTREGUE</option>
          <option value="CANCELADA" <%= filtroStatus === 'CANCELADA' ? 'selected' : '' %>>CANCELADA</option>
        </select>
      </div>
      <div class="field" style="justify-content: flex-end;">
        <button class="btn btn-secondary" type="submit">Filtrar</button>
      </div>
    </div>
  </form>

  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Descrição</th>
        <th>Origem</th>
        <th>Destino</th>
        <th>Status</th>
        <th>Motorista</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% if (!entregas || entregas.length === 0) { %>
        <tr>
          <td colspan="7" class="muted">Nenhuma entrega encontrada.</td>
        </tr>
      <% } else { %>
        <% entregas.forEach((entrega) => { %>
          <tr>
            <td><%= entrega.id %></td>
            <td><%= entrega.descricao || 'Sem descrição' %></td>
            <td><%= entrega.origem %></td>
            <td><%= entrega.destino %></td>
            <td>
              <span class="badge badge-<%= entrega.status.toLowerCase().replace(/_/g, '-') %>"><%= entrega.status %></span>
            </td>
            <td><%= entrega.motorista ? entrega.motorista.nome : 'Sem motorista' %></td>
            <td class="actions">
              <a href="/entregas/<%= entrega.id %>">Detalhes</a>
              <form action="/entregas/<%= entrega.id %>/avancar?_method=PATCH" method="POST" style="display: inline;">
                <button type="submit" class="btn btn-secondary" <%= entrega.status === 'ENTREGUE' || entrega.status === 'CANCELADA' ? 'disabled' : '' %>>Avançar</button>
              </form>
              <form action="/entregas/<%= entrega.id %>/cancelar?_method=PATCH" method="POST" style="display: inline;">
                <button type="submit" class="btn btn-danger" <%= entrega.status === 'ENTREGUE' || entrega.status === 'CANCELADA' ? 'disabled' : '' %>>Cancelar</button>
              </form>
            </td>
          </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table>
</div>
