<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title || 'Delivery Tracker' %></title>
    <style>
      body { font-family: Arial, sans-serif; margin: 0; background: #f5f7fb; color: #1f2937; }
      a { color: #2563eb; text-decoration: none; }
      nav { background: #111827; color: white; padding: 16px 24px; }
      nav a { color: white; margin-right: 16px; }
      .container { max-width: 1100px; margin: 24px auto; padding: 0 16px; }
      .card { background: white; border-radius: 10px; padding: 18px; box-shadow: 0 2px 10px rgba(0,0,0,.05); }
      .row { display: flex; justify-content: space-between; align-items: center; gap: 16px; }
      .btn { display: inline-block; padding: 10px 16px; border-radius: 8px; border: none; cursor: pointer; }
      .btn-primary { background: #2563eb; color: white; }
      .btn-secondary { background: #e5e7eb; color: #111827; }
      .btn-danger { background: #dc2626; color: white; }
      table { width: 100%; border-collapse: collapse; margin-top: 16px; }
      th, td { border-bottom: 1px solid #e5e7eb; padding: 10px; text-align: left; }
      .badge { display: inline-block; padding: 4px 10px; border-radius: 999px; font-size: 12px; font-weight: bold; }
      .badge-criada { background: #dbeafe; color: #1d4ed8; }
      .badge-em-transito { background: #fef3c7; color: #92400e; }
      .badge-entregue { background: #dcfce7; color: #166534; }
      .badge-cancelada { background: #fee2e2; color: #991b1b; }
      .alert { padding: 12px 16px; border-radius: 8px; margin-bottom: 16px; }
      .alert-success { background: #dcfce7; color: #166534; }
      .alert-error { background: #fee2e2; color: #991b1b; }
      .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; }
      .field { display: flex; flex-direction: column; gap: 6px; }
      input, select { padding: 10px 12px; border: 1px solid #d1d5db; border-radius: 8px; }
      .error { color: #b91c1c; font-size: 13px; }
      .actions { display: flex; gap: 8px; flex-wrap: wrap; }
      .muted { color: #6b7280; }
      .section { margin-top: 24px; }
    </style>
  </head>
  <body>
    <nav>
      <div class="container row">
        <div>
          <a href="/">Delivery Tracker</a>
          <a href="/entregas">Entregas</a>
          <a href="/motoristas">Motoristas</a>
        </div>
      </div>
    </nav>

    <div class="container">
      <%- include('../partials/flash') %>
      <%- body %>
    </div>
  </body>
</html>
