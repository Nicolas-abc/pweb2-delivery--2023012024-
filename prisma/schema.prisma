generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Motorista {
  id           Int       @id @default(autoincrement())
  nome         String
  cpf          String    @unique
  placaVeiculo String?
  status       String    @default("ATIVO")
  entregas     Entrega[]
  criadoEm     DateTime  @default(now())
}

model Entrega {
  id          Int                @id @default(autoincrement())
  descricao   String?
  origem      String
  destino     String
  status      String             @default("CRIADA")
  motoristaId Int?
  motorista   Motorista?         @relation(fields: [motoristaId], references: [id])
  historico   HistoricoEntrega[]
  criadoEm    DateTime           @default(now())
}

model HistoricoEntrega {
  id        Int      @id @default(autoincrement())
  data      String
  evento    String
  entregaId Int
  entrega   Entrega  @relation(fields: [entregaId], references: [id], onDelete: Cascade)
}